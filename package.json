{
  "name": "interviewgearup",
  "version": "1.0.0",
  "description": "Interview questions with level-wise answers for IT roles, plus a community board. Static site, no build step, no runtime dependencies.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test test/run.js",
    "start": "python3 -m http.server 8000",
    "test:goal": "COVERAGE_GOAL=1 node --test test/run.js",
    "content:status": "node scripts/content-status.js",
    "content:audit": "node scripts/content-audit.js",
    "refs:check": "node scripts/check-references.js",
    "seo": "node scripts/build-seo.js",
    "seo:check": "node scripts/build-seo.js --check",
    "sw:check": "node scripts/check-sw.js"
  }
}
